{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "lt hook pre-tool-use"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(lt validate:*)",
      "Bash(lt check:*)",
      "Bash(lt schema)"
    ]
  }
}
